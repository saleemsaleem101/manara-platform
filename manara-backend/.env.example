# ==============================================================
# منصة منارة - نموذج متغيرات البيئة للإنتاج والتطوير (.env.example)
# ==============================================================

# إعدادات الأمان والتشفير (NFR-01)
# في بيئة الإنتاج: يجب توليد مفتاح تشفير قوي ومعقد ووضع DEBUG=False
SECRET_KEY=django-insecure-change-this-in-production-to-a-secure-random-key-64chars!
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.manara.edu.ye

# إعدادات الحماية والـ SSL للإنتاج
SECURE_SSL_REDIRECT=True

# إعدادات قاعدة البيانات (PostgreSQL) - NFR-01
DB_NAME=manarah_db1
DB_USER=postgres
DB_PASSWORD=your-secure-database-password-here
DB_HOST=localhost
DB_PORT=5432

# أمان الوصول CORS (NFR-01)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://manara.edu.ye
FRONTEND_URL=https://manarah-platform.vercel.app

# إعدادات خادم البريد الإلكتروني (EMAIL_BACKEND) لتوثيق الحسابات واستعادة المرور
# للبيئة المحلية: يمكن استخدام 'django.core.mail.backends.console.EmailBackend'
# لبيئة الإنتاج: استخدام خادم SMTP مع التشفير
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@manara.edu.ye
EMAIL_HOST_PASSWORD=your-app-specific-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=منصة منارة <noreply@manara.edu.ye>
