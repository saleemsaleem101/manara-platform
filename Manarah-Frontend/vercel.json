{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://manara-platform-gules.vercel.app/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://manara-platform-gules.vercel.app/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
